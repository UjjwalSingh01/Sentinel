# =============================================================================
# Sentinel — Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# PostgreSQL / TimescaleDB
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secret
POSTGRES_DB=sentinel
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secret@timescaledb:5432/sentinel
DATABASE_URL_SYNC=postgresql://sentinel:sentinel_secret@timescaledb:5432/sentinel

# Redis
REDIS_URL=redis://redis:6379/0

# Redpanda (Kafka-compatible)
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_TOPIC_METRICS=metrics
KAFKA_TOPIC_LOGS=logs.raw

# JWT Authentication
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_MINUTES=10080

# Google Gemini AI (optional — platform works without it)
GEMINI_API_KEY=

# Service URLs (internal Docker network)
INGESTION_URL=http://ingestion:8001
LOG_INGESTION_URL=http://log-ingestion:8003
API_URL=http://api:8000

# Logging
LOG_LEVEL=INFO

# Notification service (Phase 5)
EMAIL_DRIVER=stub
DEFAULT_ON_CALL_EMAIL=oncall@sentinel.local
ADMIN_EMAIL_FALLBACK=admin@sentinel.local
ESCALATION_SECONDS=900
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=sentinel@localhost
SMTP_USE_TLS=true
